BADSECTOR_API_ADDR=:8080
BADSECTOR_DATABASE_URL=sqlite://./data/badsector.db
BADSECTOR_RUNTIME=./runtime
BADSECTOR_REDIS_URL=redis://localhost:6379
BADSECTOR_REDIS_HOST=127.0.0.1
BADSECTOR_REDIS_PORT=6379

# API authentication (set AUTH_DISABLED=true for local dev)
BADSECTOR_JWT_SECRET=badsector-dev-secret-change-me
BADSECTOR_AUTH_DISABLED=false
BADSECTOR_ADMIN_USER=admin
BADSECTOR_ADMIN_PASSWORD=badsector

# Signed PoW challenge HMAC key — MUST be a strong random value in production.
# Generate: openssl rand -hex 32   (all engine workers share this one secret)
# If you change it later, existing bs_pass tokens are invalidated (clients re-solve).
BADSECTOR_CHALLENGE_SECRET=badsector-dev-challenge-secret-change-me
# Ortak challenge HTML (site template boşken). Compose varsayılanı:
# /etc/badsector/challenge/template.html  ← host: ./data/challenge/template.html (gitignore)
# BADSECTOR_JS_CHALLENGE_TEMPLATE_PATH=/etc/badsector/challenge/template.html

# Cloudflare arkasi mi? false = BadSector edge (CF-Connecting-IP spoof kapali).
# true = CF-Connecting-IP guvenilir (engine + HAProxy ayni env).
BADSECTOR_CLOUDFLARE=false

# Trusted / yonetim IP'leri (virgulle). Ban + GeoIP/challenge muaf; iptables ACCEPT.
# Ornek: BADSECTOR_TRUSTED_IPS=203.0.113.10,198.51.100.5
BADSECTOR_TRUSTED_IPS=

# Attack mode kernel block (watcher). Panel: Edge Security → Attack mode kernel block + Engellenen ülkeler
# ATTACK_KERNEL_COUNTRIES=CN,BR
# ATTACK_KERNEL_ASNS=45899,394474
# ATTACK_KERNEL_ALLOW_COUNTRIES=TR

# Local dev upstream (Docker compose uses http://backend:80)
BADSECTOR_DEFAULT_BACKEND_URL=http://127.0.0.1:8081

# Docker compose overrides this to http://backend:80

# Engine hot reload (API calls this after config changes)
BADSECTOR_ENGINE_RELOAD_URL=http://localhost:9080/badsector/admin/reload
BADSECTOR_ENGINE_ADMIN_TOKEN=badsector-engine-token

# Engine trace buffer
BADSECTOR_TRACE_BUFFER_SIZE=100
BADSECTOR_TRACE_TTL=3600

# MaxMind GeoLite2 (Country + ASN) — worker downloads automatically
MAXMIND_LICENSE_KEY=
BADSECTOR_GEOIP_PATH=./data/geoip
BADSECTOR_GEOIP_SYNC_INTERVAL=24h

# TLS / Let's Encrypt
BADSECTOR_CERTS_PATH=./data/certs
BADSECTOR_ACME_EMAIL=
BADSECTOR_ACME_STAGING=false
BADSECTOR_CERT_RENEW_INTERVAL=6h
# Production edge: live | local/dev: dev
BADSECTOR_HAPROXY_CONFIG=dev

# Admin UI host port (docker compose). Default 3000. Prefer SSH tunnel in production.
# BADSECTOR_UI_PORT=3000
